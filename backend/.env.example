# --- Supabase ---
# Create a project at https://supabase.com, then run migrations/001_init.sql
# in the SQL editor, create a public Storage bucket named "shelf-media",
# and paste the Project URL + service_role key below.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=shelf-media

# --- Vision provider ---
# "auto" (default) prefers OpenAI if OPENAI_API_KEY is set, then Groq if
# GROQ_API_KEY is set, otherwise falls back to a deterministic mock vision
# client so the app runs with zero API keys. Force a specific provider with
# "mock", "openai", or "groq".
VISION_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o
# Groq: get a free key at https://console.groq.com - OpenAI-compatible API,
# very fast inference, currently a looser JSON-mode contract than OpenAI's
# strict json_schema (see backend/vision/providers/groq.py).
GROQ_API_KEY=
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# --- Video pipeline tuning (safe defaults, override if needed) ---
VIDEO_SAMPLE_FPS=1.0
VIDEO_MAX_SAMPLED_FRAMES=40
VIDEO_MAX_FRAMES_FOR_VISION=5
VIDEO_BLUR_VARIANCE_THRESHOLD=60.0
VIDEO_DUPLICATE_HASH_THRESHOLD=6
VIDEO_DARK_BRIGHTNESS_THRESHOLD=40.0
VIDEO_OVEREXPOSED_BRIGHTNESS_THRESHOLD=215.0
VIDEO_GALLERY_THUMBNAIL_MAX=12

# --- SKU grounding thresholds ---
SKU_MATCH_HIGH_THRESHOLD=88.0
SKU_MATCH_LOW_THRESHOLD=60.0
SKU_MATCH_AMBIGUOUS_MARGIN=5.0

# --- Confidence calibration ---
CONFIDENCE_HIGH_THRESHOLD=0.75
CONFIDENCE_MEDIUM_THRESHOLD=0.4

# --- Misc ---
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://[::1]:5173
MAX_UPLOAD_SIZE_MB=200
